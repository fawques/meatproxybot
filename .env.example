# Copy to .env and fill in. Never commit .env.

# ===== Legacy Mode (Single Workspace) =====
# Bot User OAuth Token (OAuth & Permissions page), starts with xoxb-
# Required for legacy single-workspace mode
# SLACK_BOT_TOKEN=xoxb-your-bot-token

# ===== OAuth Mode (Multi-Workspace / Marketplace) =====
# Slack app credentials for OAuth installation flow
# Required for multi-workspace/marketplace installations
# SLACK_CLIENT_ID=your-client-id
# SLACK_CLIENT_SECRET=your-client-secret
# SLACK_STATE_SECRET=your-state-secret

# ===== Database Configuration (Required for OAuth Mode) =====
# PostgreSQL connection string (required for OAuth multi-workspace mode)
# Format: postgresql://user:password@host:port/dbname
# DATABASE_URL=postgresql://user:password@localhost:5432/meatproxybot

# Database schema for installations table (defaults to meatproxybot_prod)
# Use meatproxybot_local for local development
# DATABASE_SCHEMA=meatproxybot_prod

# Signing Secret (Basic Information page), for request verification
SLACK_SIGNING_SECRET=your-signing-secret

# Optional: HTTP port. Defaults to 3000.
# PORT=3000

# Optional: name of the reaction that triggers the bot, without colons. Defaults to meat_proxy.
# TRIGGER_EMOJI=meat_proxy
